<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Orbbec USB (RGB-D) camera: launch/resume the app when an Orbbec
                 device is attached. The device filter (res/xml/orbbec_usb_filter)
                 matches the Orbbec vendor id so unrelated USB gear is ignored. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/orbbec_usb_filter" />

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- USB host support for the Orbbec USB (RGB-D) camera. Optional so the app
         still installs on devices without USB-OTG; the Orbbec source simply
         reports unavailable there. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Camera for the in-app live-preview capture (WebView getUserMedia). The
         capture flow streams the camera *inside* the app instead of launching
         the OS camera activity; Capacitor's BridgeWebChromeClient only grants
         the WebView's getUserMedia request once this runtime permission is
         declared and allowed. Optional hardware so the app still installs on
         camera-less devices (capture then falls back to the file picker). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Location for the optional GPS tag on captured tree sets. Without these
         the WebView's navigator.geolocation runtime request is auto-denied by
         Android (a permission not declared in the manifest can never be granted),
         which surfaces in the capture form as "GPS Unavailable". COARSE is enough
         for a tree-plot tag; FINE improves accuracy when the user allows it.
         Both are optional at runtime — the capture flow degrades to no-GPS. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- GPS hardware is not required; devices without it still install and run
         (capture simply omits the location tag). -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>
